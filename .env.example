# L3 종합 평가 LLM. 옵션: jeonbuk | gemini | claude | ollama
LLM_PROVIDER=jeonbuk

# ── 완전 로컬 실행 (API 키 불필요) ──
# LLM_PROVIDER=ollama + STT_PROVIDER=local 이면 외부 API 키 없이 전부 로컬에서 동작.
# 사전 준비: https://ollama.com 설치 후 `ollama pull gemma3:4b`
# Docker로 coach를 띄우는 경우 base URL은 host.docker.internal 사용 (compose 기본값).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=gemma3:4b

# 전북AI 학생 API (OpenAI 호환, 키는 절대 커밋 금지)
JEONBUK_API_KEY=
JEONBUK_BASE_URL=https://ai.jb.go.kr/student-api/v1
JEONBUK_CHAT_MODEL=gemma-4-31b-turbo

# STT 공급자. 옵션: jeonbuk | local
STT_PROVIDER=jeonbuk
JEONBUK_STT_MODEL=cohere-transcribe

# Gemini (https://aistudio.google.com/apikey — 카드 등록 불필요, 즉시 발급)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Claude (LLM_PROVIDER=claude 일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# 로컬 STT fallback (STT_PROVIDER=local)
WHISPER_MODEL=medium
